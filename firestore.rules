rules_version = '2';
// FoundIt security rules — Phase 2 lockdown. OWNER: Nidhi (pairs with Shanid on RBAC).
//
// Principle: the client may create/edit content it owns, but SERVER-OWNED fields
// (trust, status, matchScore, ratings, roles, strikes) are writable only by Cloud
// Functions, which use the Admin SDK and bypass these rules. Clients that try to
// set those fields are rejected here.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isVerified() { return signedIn() && request.auth.token.email_verified == true; }
    function hasRole(r) { return signedIn() && request.auth.token.role == r; }
    function isMod() { return hasRole('moderator') || hasRole('admin'); }
    // A field keeps its previous value (or stays absent) across an update.
    function keeps(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }
    // An update touches only these top-level fields.
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Public reference data — read-only to clients (seeded/admin via console/functions).
    match /categories/{id} { allow read: if true; allow write: if false; }
    match /campusZones/{id} { allow read: if true; allow write: if false; }

    // User profiles — signed-in read; you edit only your own, and only profile fields.
    match /users/{uid} {
      // Profile docs hold the student's campus email, so they are not public:
      // `if true` here let anyone on the internet enumerate every registered
      // user's email over the REST API. The display name and trust score shown
      // in the feed are denormalized onto the item docs, which stay publicly
      // readable, so nothing in the signed-out UI depends on this.
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && keeps('trustScore') && keeps('trustTier') && keeps('trustBreakdown')
        && keeps('role') && keeps('status')
        && keeps('ratingAvg') && keeps('ratingCount') && keeps('resolvedCount')
        && keeps('strikes') && keeps('verified');
      allow delete: if false;
    }

    // Lost & found reports.
    match /lostFoundItems/{itemId} {
      allow read: if true;
      allow create: if isVerified() && request.resource.data.postedBy == request.auth.uid;
      // Owner/mod may edit content, but not the server-owned matching/status fields.
      allow update: if (isMod())
        || (signedIn() && resource.data.postedBy == request.auth.uid
            && keeps('status') && keeps('matchScore') && keeps('matchedWith') && keeps('flagCount'))
        // Mark returned. Works without Cloud Functions: the poster may resolve
        // their own report, but only by naming a claim that is approved once
        // this write lands (getAfter sees the claim approval in the same batch).
        || (signedIn() && resource.data.postedBy == request.auth.uid
            && resource.data.status in ['open', 'matched']
            && request.resource.data.status == 'resolved'
            && changedOnly(['status', 'resolvedClaimId', 'resolvedAt'])
            && getAfter(/databases/$(database)/documents/lostFoundItems/$(itemId)/claims/$(request.resource.data.resolvedClaimId)).data.status == 'approved');
      allow delete: if isMod() || (signedIn() && resource.data.postedBy == request.auth.uid);

      // Claims: claimant creates their own; only the item owner or a mod resolves it.
      match /claims/{claimId} {
        function item() { return get(/databases/$(database)/documents/lostFoundItems/$(itemId)).data; }
        // Optional corroboration: the claimant's own report of the opposite
        // type ("this found calculator is the one I reported lost").
        function via() { return request.resource.data.get('viaItemId', null); }
        function viaDoc() {
          return get(/databases/$(database)/documents/lostFoundItems/$(via())).data;
        }
        // A claim holds proof of ownership. If anyone could read it, a scammer
        // could copy the real owner's answer and submit it as their own — so
        // only the poster who judges it, the claimant, and moderators may.
        allow read: if isMod()
          || (signedIn() && item().postedBy == request.auth.uid)
          // resource == null: checking whether you have claimed yet (your own
          // uid's slot) reveals nothing.
          || (signedIn() && claimId == request.auth.uid && resource == null)
          || (signedIn() && resource.data.claimantUid == request.auth.uid);
        // Not on your own post, not once the item has been returned, and one
        // per person: the claim's id is the claimant's uid, so a second claim
        // would be an update, which claimants cannot make.
        allow create: if isVerified() && request.resource.data.claimantUid == request.auth.uid
          && claimId == request.auth.uid
          && item().postedBy != request.auth.uid
          && item().status != 'resolved'
          // The link may be absent, but it cannot be faked: a cited report must
          // be one this user actually posted, and of the opposite type.
          // Otherwise anyone could point at a stranger's matching post and
          // borrow its credibility.
          && (via() == null
              || (viaDoc().postedBy == request.auth.uid && viaDoc().type != item().type));
        // Approve/reject only (FR-10). The resolver moves the status and nothing
        // else — it cannot rewrite the claimant's proof or reassign the claim —
        // and only out of 'pending', so the state machine stays one-way
        // (ARCHITECTURE.md §4.6). onClaimResolved owns everything downstream.
        allow update: if (isMod()
            || (signedIn() && get(/databases/$(database)/documents/lostFoundItems/$(itemId)).data.postedBy == request.auth.uid))
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['approved', 'rejected']
          // Declining is always allowed; approving only while the item is
          // still unreturned (get() sees the state before this write).
          && (request.resource.data.status == 'rejected' || item().status != 'resolved');
        allow delete: if false;
      }
    }

    // "My claims": a collection-group query over every item's claims, filtered
    // to the caller's own. The filter makes the query provably safe.
    match /{path=**}/claims/{claimId} {
      allow read: if signedIn() && resource.data.claimantUid == request.auth.uid;
    }

    // Marketplace listings.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isVerified() && request.resource.data.sellerUid == request.auth.uid;
      function isSeller() { return signedIn() && request.auth.uid == resource.data.sellerUid; }
      function isBuyer() {
        return signedIn() && request.auth.uid == resource.data.get('lastOffer', {}).get('buyerUid', '');
      }
      function stored() { return resource.data.get('confirmations', {}); }
      function next() { return request.resource.data.get('confirmations', {}); }
      function bothConfirmed() {
        return stored().get('seller', false) == true && stored().get('buyer', false) == true;
      }
      // Every branch names exactly the fields its author may change. The rule
      // this replaced let ANY signed-in user write every field except four
      // server-owned ones — so a stranger could reprice or even reassign
      // somebody's listing, and a buyer could forge both confirmations.
      allow update: if isMod()
        // The seller edits their own listing's content. Never the handshake.
        || (isSeller() && changedOnly(['title', 'description', 'price', 'priceType',
                                   'condition', 'category', 'location', 'keywords', 'imageURLs']))
        // A buyer places an offer — only lastOffer, only in their own name, and
        // never over a buyer who has already confirmed (that would let a second
        // buyer inherit the first one's confirmation).
        || (signedIn() && !isSeller() && changedOnly(['lastOffer'])
            && request.resource.data.lastOffer.buyerUid == request.auth.uid
            && stored().get('buyer', false) == false)
        // Handshake, for deployments without the confirmTransaction function.
        // Each party records ONLY THEIR OWN confirmation…
        || (isSeller() && changedOnly(['confirmations'])
            && next().get('seller', false) == true
            && next().get('buyer', false) == stored().get('buyer', false))
        || (isBuyer() && changedOnly(['confirmations'])
            && next().get('buyer', false) == true
            && next().get('seller', false) == stored().get('seller', false))
        // …and the flip to sold needs BOTH already stored, so it can never be
        // done in a single write by one side.
        || ((isSeller() || isBuyer()) && bothConfirmed()
            && resource.data.status == 'active'
            && changedOnly(['status', 'soldAt', 'reviewUnlocked', 'buyerUid'])
            && request.resource.data.status == 'sold'
            && request.resource.data.reviewUnlocked == true);
      allow delete: if isMod() || (signedIn() && resource.data.sellerUid == request.auth.uid);
    }

    // Chats — participants only.
    match /chats/{chatId} {
      // getOrCreateChat reads before it creates. On a document that does not
      // exist yet `resource` is null, so dereferencing resource.data denied the
      // read outright — that is what made the very first "Message" click fail
      // with "Missing or insufficient permissions". Nothing lists chats, so
      // get-only is enough and list stays closed.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if false;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      // Subcollection rules do NOT inherit the parent's gate. Without repeating
      // the participant check here, any signed-in student who could guess a
      // chat id could read the whole thread — which defeats the point of
      // in-app chat and breaks the privacy requirement. Costs one extra
      // document read per message; denormalising `participants` onto each
      // message would avoid that if it ever matters.
      match /messages/{msgId} {
        function inThread() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId));
          return signedIn() && chat != null && request.auth.uid in chat.data.participants;
        }
        allow read: if inThread();
        allow create: if inThread() && request.auth.uid == request.resource.data.senderUid;
        allow update, delete: if false;
      }
    }

    // Reviews — only the rater, valid rating, not self, and only after a completed
    // deal (the referenced listing is sold). Trust math runs server-side.
    match /reviews/{id} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.raterUid == request.auth.uid
        && request.resource.data.raterUid != request.resource.data.rateeUid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && get(/databases/$(database)/documents/listings/$(request.resource.data.contextRef)).data.status == 'sold';
      allow update, delete: if false;
    }

    // Flags — reporter creates their own; only mods read/resolve.
    match /flags/{id} {
      allow read: if isMod();
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isMod();
    }

    // Notifications — read your own; writes are function-only.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
