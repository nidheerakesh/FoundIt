rules_version = '2';
// FoundIt security rules. OWNER: Nidhi (pairs with Shanid on RBAC).
//
// STATUS: Phase-1 dev rules. Reads are open so the feed works before auth lands;
// writes require a signed-in user. LOCK THIS DOWN in Phase 2 (docs/TEAM-GUIDE §5):
//   - restrict reads to verified users
//   - creates must set postedBy/sellerUid == request.auth.uid
//   - trustScore / status / matchScore writable only by Cloud Functions (admin SDK)
//   - reviews only after a resolved exchange (docs/SCORING §1.4)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Public reference data — read-only to clients.
    match /categories/{id}  { allow read: if true; allow write: if false; }
    match /campusZones/{id}  { allow read: if true; allow write: if false; }

    // User profiles — anyone can read (feed shows names/trust); you edit only your own.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Lost & found reports.
    match /lostFoundItems/{itemId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn();      // TODO Phase 2: owner/mod only
      match /claims/{claimId} {
        allow read: if true;
        allow create, update: if signedIn();
      }
    }

    // Marketplace listings.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn();      // TODO Phase 2: owner/mod only
    }

    // Chats — only participants (locked down even in dev).
    match /chats/{chatId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      match /messages/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == request.resource.data.senderUid;
      }
    }

    match /reviews/{id}       { allow read: if true; allow create: if signedIn(); }
    match /flags/{id}         { allow read: if signedIn(); allow create: if signedIn(); }
    match /notifications/{id} { allow read: if signedIn() && request.auth.uid == resource.data.userId; allow write: if signedIn(); }
  }
}
