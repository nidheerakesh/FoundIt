rules_version = '2';
// Storage rules — item/listing images. OWNER: Hadi.
// Dev: public read, signed-in write. Phase 2: size/type limits + owner paths.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
