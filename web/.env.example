# Copy to web/.env and fill from Firebase console → Project settings → Web app.
# The web config keys below are NOT secret (safe in the client bundle),
# but we keep them out of git so each teammate/env can differ.

# Set to "false" to use a real Firebase project instead of the local emulator.
VITE_USE_EMULATOR=true

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
