# Firebase project config — get these from Firebase Console > Project Settings > Web app
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=foundit-fcfcc.firebaseapp.com
VITE_FB_PROJECT_ID=foundit-fcfcc
VITE_FB_STORAGE_BUCKET=foundit-fcfcc.firebasestorage.app
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=

# Set to 'false' to disable emulator in dev, or 'true' to enable in prod
# VITE_USE_EMULATOR=false

# Campus email domain restriction (empty = allow any domain for dev)
# VITE_CAMPUS_DOMAIN=iiitkottayam.ac.in

# Optional: Gemini API key for AI features
# VITE_GEMINI_API_KEY=
